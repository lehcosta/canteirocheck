# ── Banco ────────────────────────────────────────────────────────────────
# Runtime (web e worker): usuário de login que herda canteiro_app (sujeito a RLS).
DATABASE_URL=postgres://canteiro_runtime:runtime_dev@localhost:54329/canteirocheck
# Migrations e seed: dono das tabelas. Nunca usado em runtime.
DATABASE_URL_MIGRATOR=postgres://canteiro_owner:owner_dev@localhost:54329/canteirocheck
# Testes de integração (banco separado; os papéis são do cluster e são compartilhados).
DATABASE_URL_TEST=postgres://canteiro_runtime:runtime_dev@localhost:54329/canteirocheck_test
DATABASE_URL_TEST_MIGRATOR=postgres://canteiro_owner:owner_dev@localhost:54329/canteirocheck_test

# ── Auth (Better Auth) ───────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-bytes-ou-mais
BETTER_AUTH_URL=http://localhost:3000

# ── E-mail (magic link). Local: Mailpit em http://localhost:8025 ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CanteiroCheck <nao-responda@canteirocheck.local>"
