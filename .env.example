# ── Banco ────────────────────────────────────────────────────────────────
# Runtime (web e worker): usuário de login que herda canteiro_app (sujeito a RLS).
DATABASE_URL=postgres://canteiro_runtime:runtime_dev@localhost:54329/canteirocheck
# Migrations e seed: dono das tabelas. Nunca usado em runtime.
DATABASE_URL_MIGRATOR=postgres://canteiro_owner:owner_dev@localhost:54329/canteirocheck
# Testes de integração (banco separado; os papéis são do cluster e são compartilhados).
DATABASE_URL_TEST=postgres://canteiro_runtime:runtime_dev@localhost:54329/canteirocheck_test
DATABASE_URL_TEST_MIGRATOR=postgres://canteiro_owner:owner_dev@localhost:54329/canteirocheck_test

# ── Auth (Better Auth) ───────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-bytes-ou-mais
# Com o portless (padrão do `pnpm dev`), a URL do portless vale mais que esta: ver APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# ── E-mail (magic link). Local: Mailpit em http://localhost:8025 ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EngCheck <nao-responda@engcheck.local>"
# Caixa que recebe os pedidos de demonstração da landing page (/)
CONTATO_EMAIL=contato@engcheck.local

# ── Filas (BullMQ) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:63799

# ── Arquivos (S3). Local: RustFS, console em http://localhost:59001 ──────
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=canteiro
S3_SECRET_KEY=canteiro_dev_secret
S3_BUCKET=canteirocheck

# ── WhatsApp ─────────────────────────────────────────────────────────────
# simulado (padrão): nada sai para a Meta; use o simulador em /dev/whatsapp, na URL do `pnpm dev`
# cloud: Cloud API de verdade (preencha as 4 variáveis da Meta abaixo)
WHATSAPP_MODO=simulado
# App Secret do app na Meta (assina webhook e endpoint do Flow). Local: openssl rand -hex 24
WHATSAPP_APP_SECRET=troque-este-segredo
# Token que você define ao cadastrar o webhook na Meta. Local: openssl rand -hex 12
WHATSAPP_VERIFY_TOKEN=troque-este-token
# Chave privada RSA do endpoint de Flows (PEM em base64): pnpm --filter @canteirocheck/whatsapp gerar-chave
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_SENHA=
# Só no modo cloud (System User token, não o temporário de 24h):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
# Preço estimado por mensagem entregue, por categoria (USD). Confira a tabela da Meta.
# WHATSAPP_PRECOS_USD={"utility":"0.0080","service":"0.0080"}
# URL pública do app (o simulador posta o webhook aqui; em produção, a URL HTTPS).
# `pnpm dev` roda atrás do portless e usa a URL que ele imprime
# (https://canteirocheck.localhost, ou https://<worktree>.canteirocheck.localhost numa worktree),
# passando por cima desta e da BETTER_AUTH_URL. Scripts que rodam fora do `pnpm dev` (e2e, skills
# do Paper, fumaça do WhatsApp) leem daqui: ponha a saída de `portless get canteirocheck`.
# Sem portless: `PORTLESS=0 pnpm dev` sobe em http://localhost:3000.
APP_URL=http://localhost:3000
# Liga o simulador em /dev/whatsapp (nunca em produção)
SIMULADOR_WHATSAPP=1

# ── Leitura de DWG (serviço isolado, GPL-3.0) ────────────────────────────
DWG_EXTRACTOR_URL=http://localhost:58090

# ── Leitura de cronograma do MS Project (serviço isolado, MPXJ numa JVM) ─
MPP_EXTRACTOR_URL=http://localhost:58091

# ── IA (etapa 3 e fallback conversacional) ───────────────────────────────
# Sem chave: pendências entram pelo pré-filtro (revisão humana) e não há pontos sugeridos.
ANTHROPIC_API_KEY=
# Modelos (padrão: pontos = claude-opus-5-5; classificação de notas e de mensagens = claude-haiku-5-5)
# IA_MODELO_PONTOS=claude-opus-5-5
# IA_MODELO_CLASSIFICACAO=claude-haiku-5-5
# Cruzamento do cronograma com os projetos (riscos por fase); padrão = o modelo de pontos
# IA_MODELO_CRUZAMENTO=claude-opus-5-5
# Transcrição de áudio do WhatsApp (OpenAI). Sem chave, o áudio pede para usar o formulário.
OPENAI_API_KEY=
# IA_MODELO_TRANSCRICAO=whisper-1

# ── Observabilidade ──────────────────────────────────────────────────────
# Liga GET /api/metricas (Prometheus) com Authorization: Bearer <token>
METRICAS_TOKEN=
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Flows ainda em DRAFT na Meta: mande com mode "draft" para testar no celular antes de publicar
# WHATSAPP_FLOWS_RASCUNHO=1
# Envio por id (impresso pelo publicar), útil com Flows em DRAFT
# WHATSAPP_FLOW_IDS={"canteiro_checklist_v1":"123"}
