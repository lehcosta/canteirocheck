{
  "name": "canteirocheck",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @canteirocheck/db db:generate",
    "db:migrate": "pnpm --filter @canteirocheck/db db:migrate",
    "db:seed": "pnpm --filter @canteirocheck/db db:seed",
    "db:reset": "pnpm --filter @canteirocheck/db db:reset",
    "criar-tenant": "pnpm --filter @canteirocheck/db criar-tenant"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
