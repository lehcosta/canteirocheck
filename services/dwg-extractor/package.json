{
  "name": "canteirocheck-dwg-extractor",
  "version": "0.1.0",
  "description": "Serviço HTTP isolado que extrai entidades brutas de arquivos DWG com @mlightcad/libredwg-web (GPL-3.0).",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gerar-fixture": "./scripts/gerar-fixture.sh"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
